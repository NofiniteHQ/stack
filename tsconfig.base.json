{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "@nofinite/nuicss": ["./packages/nuicss/src/plugin/index.ts"],
      "@nofinite/nui": ["./packages/nui/src/index.ts"],
      "@nofinite/utils": ["./packages/utils/src/index.ts"],
      "@nofinite/locale": ["./packages/locale/src/index.ts"]
    }
  }
}

{
  "name": "@nofinite/markon",
  "version": "2.0.0",
  "description": "Universal, framework-agnostic rich text and content authoring engine powered by TipTap and ProseMirror.",
  "license": "Apache-2.0",
  "author": "Nofinite HQ",
  "homepage": "https://nofinite.design",
  "bugs": {
    "url": "https://github.com/NofiniteHQ/stack/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/markon.css",
    "./dist/markon.css": "./dist/markon.css",
    "./dist/*": "./dist/*",
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/package.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NofiniteHQ/stack.git",
    "directory": "packages/markon"
  },
  "keywords": [
    "nofinite",
    "markon",
    "editor",
    "rich-text",
    "tiptap",
    "prosemirror",
    "content",
    "wysiwyg",
    "react",
    "vanilla-js",
    "htmx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-focus": "^3.32.0",
    "@tiptap/extension-font-family": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extension-youtube": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@nofinite/nuicss": "workspace:*"
  }
}

{
  "name": "@nofinite/kanban",
  "version": "1.0.0",
  "description": "Universal, framework-agnostic task board and Kanban suite powered by Pragmatic Drag and Drop and styled with @nofinite/nuicss design tokens.",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs",
      "default": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NofiniteHQ/stack.git",
    "directory": "packages/kanban"
  },
  "keywords": [
    "nofinite",
    "kanban",
    "drag-and-drop",
    "task-board",
    "pragmatic-drag-and-drop",
    "react-kanban",
    "vanilla-kanban"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.2",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@nofinite/nuicss": "workspace:*"
  }
}

{
  "name": "@nofinite/nuicss",
  "version": "3.1.0",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/plugin/index.d.ts",
  "style": "./dist/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/shortcuts/index.d.ts",
      "import": {
        "types": "./dist/shortcuts/index.d.ts",
        "default": "./dist/components.mjs"
      },
      "require": {
        "types": "./dist/shortcuts/index.d.ts",
        "default": "./dist/components.js"
      },
      "default": "./dist/components.js"
    },
    "./next": {
      "types": "./dist/plugin/next.d.ts",
      "import": {
        "types": "./dist/plugin/next.d.ts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/plugin/next.d.ts",
        "default": "./dist/next.js"
      },
      "default": "./dist/next.js"
    },
    "./ssr": {
      "types": "./dist/helpers/ssr.d.ts",
      "import": {
        "types": "./dist/helpers/ssr.d.ts",
        "default": "./dist/ssr.mjs"
      },
      "require": {
        "types": "./dist/helpers/ssr.d.ts",
        "default": "./dist/ssr.js"
      },
      "default": "./dist/ssr.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "import": {
        "types": "./dist/migrate/index.d.ts",
        "default": "./dist/migrate.mjs"
      },
      "require": {
        "types": "./dist/migrate/index.d.ts",
        "default": "./dist/migrate.js"
      },
      "default": "./dist/migrate.js"
    },
    "./components.css": "./dist/components.css",
    "./components.min.css": "./dist/components.min.css",
    "./primitives.css": "./dist/primitives.css",
    "./primitives.min.css": "./dist/primitives.min.css",
    "./forms.css": "./dist/forms.css",
    "./forms.min.css": "./dist/forms.min.css",
    "./overlays.css": "./dist/overlays.css",
    "./overlays.min.css": "./dist/overlays.min.css",
    "./widgets.css": "./dist/widgets.css",
    "./widgets.min.css": "./dist/widgets.min.css",
    "./media.css": "./dist/media.css",
    "./media.min.css": "./dist/media.min.css",
    "./dist/index.css": "./dist/index.css",
    "./styles.css": "./dist/styles.css",
    "./styles.min.css": "./dist/styles.min.css",
    "./cdn": "./dist/index.global.js",
    "./html-data.json": "./dist/nuicss.html-data.json",
    "./css-data.json": "./dist/nuicss.css-data.json",
    "./package.json": "./package.json",
    "./postcss": "./postcss.js"
  },
  "bin": {
    "nuicss": "./bin/nuicss.js"
  },
  "files": [
    "dist",
    "bin",
    "postcss.js",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms-full.txt",
    "llms-components.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NofiniteHQ/stack.git",
    "directory": "packages/nuicss"
  },
  "keywords": [
    "nofinite",
    "nuicss",
    "css",
    "utility-css",
    "design-system",
    "styling"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unocss/config": "^66.10.5",
    "@unocss/core": "^66.10.5",
    "@unocss/postcss": "^66.10.5",
    "@unocss/preset-wind4": "^66.10.5",
    "@unocss/processor-lightningcss": "^66.10.5",
    "@unocss/vite": "^66.10.5",
    "glob": "^13.0.6",
    "unocss": "^66.10.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@unocss/runtime": "^66.10.5",
    "jiti": "^2.7.0",
    "postcss": "^8.5.28"
  },
  "scripts": {
    "build": "nx run nuicss:build && npm run build:cdn",
    "build:cdn": "node build-cdn.js"
  },
  "jsdelivr": "./dist/index.global.js",
  "unpkg": "./dist/index.global.js"
}

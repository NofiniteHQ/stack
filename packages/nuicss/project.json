{
  "name": "nuicss",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nuicss/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["build-cdn"],
      "options": {
        "outputPath": "packages/nuicss/dist",
        "configFile": "packages/nuicss/vite.config.ts"
      }
    },
    "build-cdn": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/nuicss",
        "command": "pnpm exec esbuild src/cdn.ts --bundle --minify --outfile=dist/browser.js"
      }
    }
  }
}

{
  "name": "@nofinite/utils",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NofiniteHQ/stack.git",
    "directory": "packages/utils"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./otp": {
      "types": "./dist/types/otp/index.d.ts",
      "import": "./dist/otp/index.js",
      "default": "./dist/otp/index.js"
    },
    "./password": {
      "types": "./dist/types/password/index.d.ts",
      "import": "./dist/password/index.js",
      "default": "./dist/password/index.js"
    },
    "./jwt": {
      "types": "./dist/types/jwt/index.d.ts",
      "import": "./dist/jwt/index.js",
      "default": "./dist/jwt/index.js"
    },
    "./uuid": {
      "types": "./dist/types/uuid/index.d.ts",
      "import": "./dist/uuid/index.js",
      "default": "./dist/uuid/index.js"
    },
    "./env": {
      "types": "./dist/types/env/index.d.ts",
      "import": "./dist/env/index.js",
      "default": "./dist/env/index.js"
    },
    "./email": {
      "types": "./dist/types/email/index.d.ts",
      "import": "./dist/email/index.js",
      "default": "./dist/email/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "jose": "^6.2.10",
    "uuid": "^14.0.2",
    "zeptomail": "^8.0.1"
  }
}

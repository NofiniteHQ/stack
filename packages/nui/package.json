{
  "name": "@nofinite/nui",
  "version": "2.0.3",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    },
    "./utils/*": {
      "types": "./dist/types/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.cjs",
      "default": "./dist/utils/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NofiniteHQ/stack.git",
    "directory": "packages/nui"
  },
  "keywords": [
    "nofinite",
    "nui",
    "react",
    "react-components",
    "ui",
    "design-system",
    "component-library"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test-storybook": "test-storybook",
    "generate": "node scripts/generate.js"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@vidstack/react": "^1.15.6",
    "@visx/axis": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "@visx/vendor": "^4.0.0",
    "@visx/visx": "^4.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.553.0",
    "react-hook-form": "^7.84.0",
    "tailwind-merge": "^3.6.0",
    "vidstack": "^1.15.6"
  },
  "devDependencies": {
    "@nofinite/nuicss": "workspace:*",
    "@storybook/test-runner": "^0.24.4",
    "jest-image-snapshot": "^6.5.2",
    "playwright": "^1.62.0",
    "vitest-axe": "^0.1.0",
    "valibot": "^1.4.2",
    "@hookform/resolvers": "^5.7.1"
  }
}
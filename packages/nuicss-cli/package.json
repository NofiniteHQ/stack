{
  "name": "nuicss",
  "version": "0.1.0",
  "description": "Lightning-fast standalone compiler and toolkit for the NUICSS design system.",
  "private": false,
  "type": "module",
  "bin": {
    "nuicss": "./bin/nuicss.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin/nuicss.js",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/package.json",
    "!dist/node_modules",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "build:ts": "node scripts/build-cli.mjs",
    "build:binaries": "node scripts/build-binaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nofinite/nuicss": "workspace:*",
    "@unocss/cli": "^66.10.5",
    "@unocss/core": "^66.10.5",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "colorette": "^2.0.20",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "nuicss",
    "nui",
    "css",
    "compiler",
    "design-system",
    "oklch",
    "cli",
    "tailwindcss",
    "unocss"
  ],
  "author": "NofiniteHQ",
  "license": "Apache-2.0",
  "homepage": "https://nofinite.design",
  "bugs": {
    "url": "https://github.com/NofiniteHQ/stack/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NofiniteHQ/stack.git",
    "directory": "packages/nuicss-cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

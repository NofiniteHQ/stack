{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "./out-tsc/vitest",
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.ts"
  ]
}
